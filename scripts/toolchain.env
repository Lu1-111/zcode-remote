# 本机安卓工具链位置。换机器只改这个文件；其余脚本都经 scripts/common.sh 来 source 它。
#
# 这里不要写代理：Gradle、wrapper 只读用户级的 ~/.gradle/gradle.properties，那里已经配好。

export JAVA_HOME=/home/lululu/.jdks/jdk-17.0.21.1+2
export ANDROID_HOME=/home/lululu/Android/Sdk

# 旧变量名，个别工具还在读。必须和 ANDROID_HOME 指向同一处，否则 AGP 会报冲突。
export ANDROID_SDK_ROOT="$ANDROID_HOME"

# 这台机器的 PATH 里原本没有 java，而 apksigner、keytool 都要用。已加过就不重复加。
case ":$PATH:" in
    *":$JAVA_HOME/bin:"*) ;;
    *) export PATH="$JAVA_HOME/bin:$PATH" ;;
esac
