    <string name="more_reload">重新加载</string>
    <string name="more_open_in_browser">在浏览器中打开</string>
    <string name="more_copy_link">复制当前链接</string>
    <string name="more_sign_out">退出登录</string>
    <string name="more_browser_confirm_title">在浏览器中打开？</string>
    <string name="more_browser_confirm_body">同一台电脑同一时间只能一个页面在线。在浏览器里打开后，App 里的这个页面可能被踢下线（反过来也一样），请错开使用。</string>
    <string name="more_browser_confirm_ok">打开</string>
    <string name="more_copy_confirm_title">复制当前链接？</string>
    <string name="more_copy_confirm_body">链接等同于这台电脑的控制权，请像密码一样保管，不要发给不信任的人或群。确定复制到剪贴板吗？</string>
    <string name="more_copy_confirm_ok">复制</string>
    <string name="more_no_link_to_copy">当前没有可复制的电脑链接</string>
    <string name="more_link_copied">已复制当前链接</string>
    <string name="more_signout_confirm_title">退出登录？</string>
    <string name="more_signout_confirm_body">将清除 App 里保存的登录状态（等同网页里的「切换账号」），已添加的电脑不受影响。确定退出登录吗？</string>
    <string name="more_signout_confirm_ok">退出登录</string>
    <string name="more_signed_out">已退出登录</string>
