    <string name="list_delete">删除</string>
    <string name="list_rename_title">给电脑改名</string>
    <string name="list_rename_label">电脑名</string>
    <string name="list_delete_title">删除「%1$s」？</string>
    <string name="list_delete_body">只从本 App 的列表里删除，电脑端的远程控制不受影响。\n电脑名和链接都会从手机上清掉。</string>
    <string name="list_delete_confirm">删除</string>
    <string name="list_footer_hint">电脑从电脑端 ZCode 的远程控制弹窗里来：扫码或「复制链接」后添加到本 App。</string>

    <!-- 引导页：第一次使用、还没有电脑（方案第 4、10、11、12、14 条）。 -->
    <string name="onboarding_title">ZCode 遥控</string>
    <string name="onboarding_subtitle">还没有添加电脑。在电脑端 ZCode 里打开远程控制弹窗，就能拿到二维码和链接。</string>
    <string name="onboarding_fallback_entry">免扫码入口</string>
    <string name="onboarding_fallback_hint">不扫码直接进：登录同一账号后，从页面里的电脑列表选择电脑。</string>
    <string name="onboarding_ways_title">添加电脑的三种方式</string>
    <string name="onboarding_way_scan">① 扫码：对准电脑端远控弹窗里的二维码。</string>
    <string name="onboarding_way_paste">② 粘贴：点电脑端弹窗里的「复制链接」，回到本 App 粘贴（可以用「读取剪贴板」）。</string>
    <string name="onboarding_way_share">③ 分享或打开链接：在浏览器里打开链接后，用系统「分享」发给本 App，或在「打开方式」里选本 App。</string>
    <string name="onboarding_assetlinks_note">注意：zcode.z.ai 没有发布应用关联（assetlinks.json），系统不会自动唤起本 App——第一次要在「打开方式」里手动选一次，之后可以设为默认。</string>
    <string name="onboarding_scan_button">扫码添加</string>
    <string name="onboarding_add_button">手动添加</string>
    <string name="onboarding_workspace_note">工作区：手机端不能新建或添加工作区，只能访问电脑端当前窗口里已打开的工作区；一个桌面窗口只有一个远控会话，要换窗口就在那个窗口再点一次远控入口。</string>

    <!-- 添加电脑（粘贴，方案第 12 条）。 -->
    <string name="add_title">添加电脑</string>
    <string name="add_instructions">把电脑端弹窗里的链接粘贴到这里。链接会原样保存、原样加载，App 不会改动它。</string>
    <string name="add_link_label">电脑链接</string>
    <string name="add_link_placeholder">https://zcode.z.ai/remote/v4?…</string>
    <string name="add_read_clipboard">读取剪贴板</string>
    <string name="add_clipboard_confirm_title">读取剪贴板？</string>
    <string name="add_clipboard_confirm_body">只读取一次剪贴板内容，填进下面的输入框。剪贴板里应当是电脑端「复制链接」复制的那条链接。</string>
    <string name="add_clipboard_confirm_ok">读取</string>
    <string name="add_clipboard_empty">剪贴板里没有可用的文本。</string>
    <string name="add_save_and_connect">添加并连接</string>
    <string name="add_open_entry">打开（不保存为电脑）</string>
    <string name="add_valid_computer">识别到电脑：%1$s</string>
    <string name="add_entry_link">这条链接不带电脑标识，是免扫码入口：可以直接打开，不会保存为电脑。</string>
    <string name="add_invalid_link">不是有效的电脑链接：必须是 https://zcode.z.ai/remote/v4 开头的地址。</string>
    <string name="link_legacy">旧版链接，请在电脑端重新打开远控弹窗扫码</string>

    <!-- 扫码（方案第 10 条）。 -->
    <string name="scan_title">扫码添加</string>
    <string name="scan_hint">对准电脑端远控弹窗里的二维码</string>
    <string name="scan_invalid">这个二维码不是电脑链接</string>
    <string name="scan_permission_needed">扫码需要相机权限。不授权也可以改用粘贴方式添加。</string>
    <string name="scan_grant_permission">授予权限</string>
    <string name="scan_switch_to_paste">改用粘贴</string>

    <!-- 设置与更多（放在电脑列表页；方案第 7 条退出登录、第 16 条建议项、方案 risks 第 4 条的提示）。 -->
