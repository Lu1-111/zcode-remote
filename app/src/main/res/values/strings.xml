    <string name="action_save">保存</string>
    <string name="action_close">关闭</string>
    <string name="action_back">返回</string>

    <!-- 电脑列表页（方案第 9、13 条）。界面只显示电脑名，不显示链接。 -->
    <string name="list_title">电脑</string>
    <string name="list_action_scan">扫码</string>
    <string name="list_action_add">添加</string>
    <string name="list_action_more">更多</string>
    <string name="list_in_use">使用中</string>
