<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">ZCode 遥控</string>

    <!-- 原生断网页（方案第 15 条 ⑤）。文案按 risks 第 3 条：不要把它说成登录问题，页面上不出现任何地址。 -->
    <string name="web_error_title">页面没有加载出来</string>
    <string name="web_error_body">请确认电脑端 ZCode 正在运行且已登录。\n也请检查手机的网络连接。</string>
    <string name="web_error_retry">重试</string>
    <!-- 按了「重试」之后这一页先不撤，要让人看得出重试已经在进行。 -->
    <string name="web_error_retrying">正在重试…</string>

    <!-- 页面想拉起别的 App（weixin://、intent:// 等）时被拦下的提示（方案第 5 条）。 -->
    <string name="web_login_scheme_blocked">请使用页面内的验证码或密码方式登录</string>

    <!-- window.open 打开的外链要交给系统浏览器，但设备上没有浏览器能接。 -->
    <string name="web_no_browser">没有找到能打开这个链接的浏览器</string>

    <!-- 保存副本（M4，方案第 16 条）。通道哪一步走不通就提示，不崩溃、不卡住。 -->
    <string name="save_unsupported">暂不支持保存</string>
    <string name="save_too_large">文件超过 50MB，无法保存副本</string>
    <string name="save_saved">已保存副本</string>
    <string name="save_failed">保存副本失败</string>

