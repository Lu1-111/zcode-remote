<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      只申请网络和相机两类系统权限，白名单由 scripts/verify-apk.sh 把关：
        android.permission.INTERNET（M2，WebView 联网）
        android.permission.CAMERA   （M3，扫码；用到时才在运行时申请）
      链接和登录凭证按密码对待，所以 application 上的几项从第一天起就关死：
      不备份、不迁移、不走明文。
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      有 CAMERA 权限不等于必须有相机：没有后置摄像头的设备（部分平板、ChromeOS）也能装。
      扫码那页在拿不到相机时引导改用粘贴方式添加。这行不加，Lint 会按
      PermissionImpliesUnsupportedChromeOsHardware 报 error。
    -->
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <!--
      enableOnBackInvokedCallback：返回键一律经 OnBackInvokedCallback 交给 App（App 这头是 OnBackPressedDispatcher / BackHandler），
      不再派发 KEYCODE_BACK。targetSdk 36 起 Android 16 默认就是打开的；这里写明，Android 13 到 15 上走的也是同一条路，
      各个系统版本上返回键的行为一致，模拟器（Android 15）上实测到的也是真机上会走到的那条路。更老的系统不认这一项，照旧。
      主题固定深色：网页那头是深色页面，原生界面（M3 起有电脑列表等）也用深色，系统栏图标用浅色。
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.NoActionBar"
        tools:ignore="DataExtractionRules">

        <!--
          全应用唯一的 Activity，也是唯一的导出组件。
          singleTask：App 里永远只有一个 Activity、一个 WebView。注册了「打开链接」「分享」之后，
          从别的 App 再次唤起时走 onNewIntent，不会再叠出第二个实例去抢同一个远控会话。

          windowSoftInputMode=adjustResize：软键盘弹出时把它的高度报给窗口，WebView 外壳据此缩出位置，
          输入框不被键盘遮住（方案第 15 条 ④）。

          configChanges：转屏、进出分屏（尺寸变了）、切换深浅色、改字号这几种变化不重建界面，由界面自己响应。
          WebView 实例本来就在 ViewModel 里，界面重建也不会重建它；但界面一重建，WebView 就要从窗口上摘下来再挂回去，
          页面会先被当成「隐藏」再「显示」。手机页隐藏时主动挂起连接，所以转个屏连接就断一次。
          不重建界面就没有这一下：模拟器上实测，转屏、深浅色、字号、分屏前后页面始终可见，连接没断。
          没列在这里的变化（语言、布局方向、显示密度等）照常重建界面，WebView 由 ViewModel 留着，页面同样不重新加载。
          以后在这里放相机预览之类跟尺寸走的原生控件，要自己响应尺寸变化，不能指望界面重建。

          第二个 intent-filter（M3，方案第 11 条）：接收 zcode.z.ai/remote/v4 的 https 链接和 text/plain 的分享。
          zcode.z.ai 没有发布 assetlinks.json，系统不会自动唤起本 App，用户要在「打开方式」里选一次（界面里有说明），
          所以这里不写 autoVerify。
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="zcode.z.ai" />
                <data android:pathPrefix="/remote/v4" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!--
          AndroidX 的库清单会自动带进导出组件，这里一律去掉，保持「除主 Activity 外没有导出组件」。
          ProfileInstallReceiver 来自 androidx.profileinstaller，只用于安装基线配置，本 App 不需要。
          MissingClass 是误报：这个库只出现在运行时类路径上（AndroidX 的传递依赖），Lint 在源清单里找不到它的类。
          以后再冒出别的导出组件，scripts/verify-apk.sh 会报不通过，照这个样子加一条，不要去放宽验收脚本。
        -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
    </application>

</manifest>
